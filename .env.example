# Application Configuration
APP_NAME=Media Player API
APP_VERSION=1.0.0
DEBUG=True
HOST=0.0.0.0
PORT=8000

# MySQL Database Configuration
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=mediaplayer_db

# Full Database URL (Overrides components if set)
# For MySQL: mysql+pymysql://root:password@localhost:3306/mediaplayer_db
# For SQLite (dev fallback if MySQL is offline): sqlite:///./mediaplayer.db
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/mediaplayer_db

# Security & JWT
JWT_SECRET_KEY=mediaplayer_super_secret_jwt_key_development_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Storage
UPLOAD_DIR=./uploads
STATIC_DIR=./static
MAX_UPLOAD_SIZE_MB=50
